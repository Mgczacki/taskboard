#!/usr/bin/env node
// tb — the Taskboard command line. Used by agents (for example `tb review <file>`) and by the controller agent.
// Talks to the local Taskboard server with the token in ~/.taskboard/token.
import { spawnSync } from 'node:child_process';
import { readFileSync } from 'node:fs';
import { homedir } from 'node:os';
import { basename, dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const URL_BASE = process.env.TB_URL || 'http://127.0.0.1:4317';
const token = (() => { try { return readFileSync(process.env.TB_TOKEN_FILE || join(homedir(), '.taskboard', 'token'), 'utf8').trim(); } catch { return ''; } })();
// A task session sends its task token (server/task-token.ts). A session launched before the release that added
// TB_TASK_TOKEN keeps its old environment, so tb then reads the token from the file that the server writes for each task
// (~/.taskboard/task-tokens/<TASK_ID>, mode 0600). tb also names the task in x-tb-actor: the server refuses a request
// that names a task without that task's token, so a session with no token never acts as the user.
function taskKey(id) {
  if (process.env.TB_TASK_TOKEN) return process.env.TB_TASK_TOKEN;
  if (!/^[A-Za-z0-9][A-Za-z0-9_-]*$/.test(id)) return '';
  const f = process.env.TB_TOKEN_FILE;
  // TB_TOKEN_FILE is the task token file for a new session, or ~/.taskboard/token (the server folder) for an old one
  const dirs = [f && basename(dirname(f)) === 'task-tokens' && basename(f) === id ? dirname(f) : '', f && basename(f) === 'token' ? join(dirname(f), 'task-tokens') : '', join(homedir(), '.taskboard', 'task-tokens')];
  for (const d of dirs.filter(Boolean)) { try { const k = readFileSync(join(d, id), 'utf8').trim(); if (k) return k; } catch {} }
  return '';
}
const actorHeaders = () => {
  const id = process.env.TASK_ID;
  if (id === 'controller') return { 'x-tb-actor': 'controller', 'x-tb-mail-controller': process.env.TB_MAIL_CONTROLLER_TOKEN || '' };
  if (!id) return {};
  const key = taskKey(id);
  if (!key) { console.error('tb: This session has no task token. Park and resume the task, or ask the controller.'); process.exit(1); }
  return { 'x-tb-actor': id, 'x-tb-task-token': key };
};
const args = process.argv.slice(2);
const flag = (name, def) => { const i = args.indexOf(name); if (i < 0) return def; const v = args[i + 1]; args.splice(i, 2); return v; };
const has = name => { const i = args.indexOf(name); if (i < 0) return false; args.splice(i, 1); return true; };

// a part of the controller guidance that the controller reads on demand (server/agents.ts controllerGuide)
async function guide(topic) {
  const r = await fetch(`${URL_BASE}/api/controller/guide/${topic}`, { headers: { 'x-taskboard-token': token } });
  if (!r.ok) { console.error(`tb: could not read the ${topic} guide (${r.status}).`); process.exit(1); }
  return r.text();
}
async function call(method, path, body) {
  const r = await fetch(URL_BASE + path, { method, headers: { 'content-type': 'application/json', 'x-taskboard-token': token, ...actorHeaders() }, body: body ? JSON.stringify(body) : undefined });
  const text = await r.text(); let data; try { data = JSON.parse(text); } catch { data = text; }
  if (!r.ok) { console.error(`tb: ${data && data.error ? data.error : r.statusText}${data?.next ? ` Next: ${data.next}` : ''}`); if (data?.matches) console.error(JSON.stringify({ matches: data.matches, hasMore: data.hasMore }, null, 2)); process.exit(1); }
  if (r.status === 202 && data.permit) return data;
  if (r.status === 202 && data.push) return data;
  // 202: the action waits for the user's approval on the Taskboard dashboard
  if (r.status === 202 && data.approval) {
    console.log(`Approval pending: card ${data.approval.id}. ${data.approval.summary}`);
    process.exitCode = 2;
    return data;
  }
  return data;
}
let tasksCache;
const tasks = async () => (tasksCache ||= await call('GET', '/api/tasks'));
async function task(ref) {
  const all = await tasks(); const n = String(ref || '').replace(/^#/, '');
  const t = all.find(x => String(x.num) === n || x.id === ref);
  if (!t) { console.error(`tb: no task ${ref}`); process.exit(1); }
  return t;
}
// tb new --after / --replaces / --follows / --related (or the same fields in a --batch plan): a task number, or several
// separated by commas. The server adds the links once the task exists and puts one line about each in its prompt.
function startLinks(s) {
  const list = v => (Array.isArray(v) ? v : String(v ?? '').split(',')).map(x => String(x).trim()).filter(Boolean);
  const out = [
    ...list(s.after).map(to => ({ kind: 'dependsOn', to })),
    ...list(s.replaces).map(to => ({ kind: 'replaces', to, folded: !!s.folded })),
    ...list(s.follows).map(to => ({ kind: 'followUpOf', to })),
    ...list(s.related).map(to => ({ kind: 'relatedTo', to })),
  ];
  return out.length ? out : undefined;
}
// tb dep and tb deps (server/links.ts)
const LINK_FLAGS = [['--on', 'dependsOn'], ['--replaces', 'replaces'], ['--follows', 'followUpOf'], ['--related', 'relatedTo']];
function linkFlag() {
  for (const [f, kind] of LINK_FLAGS) { const v = flag(f); if (v !== undefined) return { kind, to: v }; }
  return null;
}
const OUT_LABEL = { dependsOn: 'Blocked by', replaces: 'Replaces', followUpOf: 'Follow-up of', relatedTo: 'Related to' };
const IN_LABEL = { dependsOn: 'Waited on by', replaces: 'Replaced by', followUpOf: 'Followed up by', relatedTo: 'Related to' };
const when = iso => iso ? iso.slice(0, 16).replace('T', ' ') : '';
const who = by => by?.actor === 'task' ? `task ${by.task}` : by?.actor || '?';
const ref = b => `#${b.num} ${b.status.padEnd(9)} ${b.title}`;
function printDeps(d) {
  console.log(`#${d.task.num} ${d.task.title}  (${d.task.status}${d.state ? `, ${d.state}` : ''})`);
  const rows = [
    ...d.out.map(l => ({ label: l.kind === 'dependsOn' && l.done ? 'Depended on (done)' : OUT_LABEL[l.kind], b: l.kind === 'dependsOn' && l.now && l.now.id !== l.to ? l.now : l.task, l, note: l.kind === 'dependsOn' && l.now && l.now.id !== l.to ? `replaces #${l.task.num}` : '' })),
    ...d.in.map(l => ({ label: l.kind === 'dependsOn' && l.done ? 'Was waited on by (done)' : IN_LABEL[l.kind], b: l.from, l, note: '' })),
  ];
  if (!rows.length) console.log('  No links.');
  for (const label of [...new Set(rows.map(x => x.label))]) {
    console.log(`  ${label}:`);
    for (const x of rows.filter(y => y.label === label))
      console.log(`    ${ref(x.b)}${x.l.folded ? '  (folded)' : ''}${x.note ? `  (${x.note})` : ''}${x.l.note ? `  "${x.l.note}"` : ''}  [link ${x.l.id}, ${who(x.l.by)}, ${when(x.l.at)}]`);
  }
  if (d.parent && typeof d.parent === 'object') console.log(`  Started by: ${ref(d.parent)}`);
  else if (d.parent === 'controller') console.log('  Started by: the controller');
  if (d.children.length) console.log(`  Started: ${d.children.map(c => '#' + c.num).join(' ')}`);
  if (d.set.length > 1) console.log(`  Linked set: ${d.set.map(c => '#' + c.num).join(' ')}`);
}
function printSet(s, byId) {
  const num = id => '#' + (byId[id]?.num ?? id);
  const c = s.counts;
  const parts = [[c.waitsForYou, 'wait for you'], [c.blocked, 'blocked'], [c.working, 'working'], [c.other, 'idle or other'], [c.replaced, 'replaced or folded'], [c.archived, 'archived']].filter(([n]) => n).map(([n, t]) => `${n} ${t}`);
  console.log(`Linked set: ${s.tasks.map(t => '#' + t.num).join(' ')}`);
  console.log(`  ${parts.join(', ') || 'no open tasks'}.`);
  if (s.chain.length) console.log(`  Longest chain: ${s.chain.map(id => `${num(id)} (${byId[id]?.status}${byId[id]?.state === 'blocked' ? ', blocked' : ''})`).join(' -> ')}`);
  if (s.waiting.length) {
    console.log('  Waits for you:');
    for (const w of s.waiting) console.log(`    #${String(w.num).padEnd(4)} ${w.status.padEnd(10)} ${w.ask || w.title}${w.blockedBy.length ? `  (still blocked by ${w.blockedBy.map(num).join(' ')})` : ''}`);
  }
  if (s.links.length) {
    console.log('  Links:');
    for (const l of s.links) console.log(`    ${num(l.from)} ${l.kind}${l.kind === 'replaces' && l.folded ? ' (folded)' : ''}${l.done ? ' (done)' : ''} ${num(l.to)}${l.note ? `  "${l.note}"` : ''}`);
  }
}
// errorLabel: a model or API error (server/agent-errors.ts shortLabel), "Stopped: model overloaded" or "Retrying (attempt 3/10)"
const line = t => `#${String(t.num).padEnd(4)} ${t.status.padEnd(10)} ${t.agent.padEnd(11)} ${t.title}${t.errorLabel ? `  — ${t.errorLabel}${t.agentError?.text ? `: ${t.agentError.text}` : ''}` : ''}${t.ask ? `  — waiting: ${t.ask}` : ''}`;
const sleep = ms => new Promise(r => setTimeout(r, ms));

