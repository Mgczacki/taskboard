#!/usr/bin/env node
// tb — the Taskboard command line. Used by agents (for example `tb review <file>`) and by the controller agent.
// Talks to the local Taskboard server with the token in ~/.taskboard/token.
import { spawnSync } from 'node:child_process';
import { readFileSync } from 'node:fs';
import { homedir } from 'node:os';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const URL_BASE = process.env.TB_URL || 'http://127.0.0.1:4317';
const token = (() => { try { return readFileSync(process.env.TB_TOKEN_FILE || join(homedir(), '.taskboard', 'token'), 'utf8').trim(); } catch { return ''; } })();
const args = process.argv.slice(2);
const flag = (name, def) => { const i = args.indexOf(name); if (i < 0) return def; const v = args[i + 1]; args.splice(i, 2); return v; };
const has = name => { const i = args.indexOf(name); if (i < 0) return false; args.splice(i, 1); return true; };

async function call(method, path, body) {
  const r = await fetch(URL_BASE + path, { method, headers: { 'content-type': 'application/json', 'x-taskboard-token': token, 'x-tb-actor': process.env.TASK_ID || '', 'x-tb-mail-controller': process.env.TB_MAIL_CONTROLLER_TOKEN || '' }, body: body ? JSON.stringify(body) : undefined });
  const text = await r.text(); let data; try { data = JSON.parse(text); } catch { data = text; }
  if (!r.ok) { console.error(`tb: ${data && data.error ? data.error : r.statusText}${data?.next ? ` Next: ${data.next}` : ''}`); if (data?.matches) console.error(JSON.stringify({ matches: data.matches, hasMore: data.hasMore }, null, 2)); process.exit(1); }
  if (r.status === 202 && data.permit) return data;
  if (r.status === 202 && data.push) return data;
  // 202: the action waits for the user's approval on the Taskboard dashboard
  if (r.status === 202 && data.approval) {
    console.log(`Waiting for the user to approve on the Taskboard dashboard: ${data.approval.summary}`);
    for (;;) {
      await new Promise(res => setTimeout(res, 2000));
      let a;
      try {
        const r2 = await fetch(`${URL_BASE}/api/approvals/${data.approval.id}`, { headers: { 'x-taskboard-token': token } });
        if (r2.status === 404) { console.error('tb: not done: the approval was lost because Taskboard restarted before you decided. Nothing was run; ask again.'); process.exit(3); }
        a = await r2.json();
      } catch { continue; } // server restarting: keep waiting
      if (a.state === 'pending' || a.state === 'running') continue;
      if (a.state !== 'approved') { console.error(`tb: not done: ${a.result || a.state}`); process.exit(3); }
      console.log(a.result); return { approved: true };
    }
  }
  return data;
}
let tasksCache;
const tasks = async () => (tasksCache ||= await call('GET', '/api/tasks'));
async function task(ref) {
  const all = await tasks(); const n = String(ref || '').replace(/^#/, '');
  const t = all.find(x => String(x.num) === n || x.id === ref);
  if (!t) { console.error(`tb: no task ${ref}`); process.exit(1); }
  return t;
}
const line = t => `#${String(t.num).padEnd(4)} ${t.status.padEnd(10)} ${t.agent.padEnd(11)} ${t.title}${t.ask ? `  — waiting: ${t.ask}` : ''}`;
const sleep = ms => new Promise(r => setTimeout(r, ms));

const HELP = `tb — Taskboard command line
  tb info                            this machine's name, its Taskboard server and its controller
  tb list [--status needs-you,working] [--group <name>] [--json]
  tb show <task>                     task note, status and the last log entry
  tb log <task…> [--last n]
  tb tail <task> [-n lines]          last lines of the agent's terminal
  tb result <task>                   the agent's last message and its outbox documents
  tb wait <task…> [--until done|needs-you|any] [--timeout seconds]
  tb accounts [--json]              accounts with sign-in state, usage, and routing rules
  tb move <task> --account <id> [--instruction "<text>"]
                                     continue the task on that account, with a handoff when needed
  tb send <task> "<text>"            type (or paste, when long) text into the agent's input box, check that the box
                                     holds it, then press Enter. Empty text is refused.
  tb resume <task>                   bring back a parked or archived task; then use tb send
  tb new --agent auto|claude|codex|antigravity --folder <path> [--account <id>] [--model <name>] [--title <t>] [--worktree <branch>|--no-worktree] [--group <name>] "<prompt>"
  tb new --batch <plan.json>         [{ agent, folder, title, prompt, account?, model?, worktree?, group? }, …]
  tb ask spin-off <task> [--answer n] [--title <t>] [--agent claude|codex|antigravity] [--account <id>] [--folder <path>] [--worktree <branch>]
                                     start from a completed Ask answer; n is its 1-based position
  tb group list | tb group add <group> <task…> | tb group rm <group> <task…>
  tb doc send <task>:<file> <task>   send a document from one task's outbox to another task's inbox
  tb mail                            messages with other people (A2A Notes over Slack) and notes to you: run for command help
  tb review <file>                   ask the user to review a document from your outbox
  tb release-request                 ask the user to allow one Taskboard release on the dashboard
  tb restart [--yes]                 the user: restart the installed Taskboard (no release); the controller: ask on the dashboard
  tb permit request --reason "text" --command "program args" [--cwd PATH] [--timeout 30] [--network]
  tb permit request --reason "text" --steps steps.json
  tb suggest "program args" --why "reason" [--cwd PATH] [--risk "risk"] [--timeout 30]
  tb suggest --steps steps.json --why "reason" [--risk "risk"]
  tb permit result ID [--wait] | tb permit list
  tb permit approve ID [--user-request "the user's chat message"]   controller only
  tb git merge-request               ask the user to merge your worktree branch into local master
  tb git commit "<message>"           commit changes in your own worktree
  tb git rebase [BASE]                rebase your own branch onto local master, or onto a remote branch such as
                                     origin/master or origin/prod (runs git fetch first). It saves the old
                                     head as a backup before it changes the branch
  tb git rebase --continue            stage resolved conflicts and finish the approved merge
  tb git rebase --abort               stop a rebase in your own worktree
  tb git repair --squash --base BASE -m "<message>"
                                     make your branch one commit over BASE (master or a remote branch)
  tb git repair --drop COMMIT [--base BASE]
                                     remove one commit that only your branch holds
  tb git repair --restore BACKUP | --list
                                     undo a repair or rebase with the backup it printed, or list the backups
  tb git check [--base BASE]          list the files your branch changes and warn about large or unsafe files
                                     Without a base, rebase, repair and check use local master. A repository
                                     without master uses the same base as tb git push-request.
  tb git push-request --reason "text" [--branch BRANCH] [--remote REMOTE] [--base BASE] [--then-release]
                                     BASE is master or a remote branch such as origin/prod. Without it, Taskboard
                                     uses the base from tb git rebase or tb git repair, then origin/HEAD.
                                     After a rebase or repair of a pushed branch, the user can approve a force
                                     push on the card. The task cannot ask for --force itself
  tb git push-result ID [--wait]      read the push result
  tb inbox wait [--timeout seconds]  wait until a file arrives in your inbox (uses TASK_ID; default 3600 s);
                                     prints each file's path and sender; exit 0 = files, 2 = timed out
  tb park|archive <task>             set aside a task or end and archive it
  tb run [--port n] [--stop "<command>"] [--cwd dir] [--task <task>] <name> -- <command…>
                                     start a dev server, database or other process for your task;
                                     Taskboard ends it when the task is archived or suspended
  tb ps [--task <task>]              the processes of your task
  tb ps --group <group>              the browsers and processes of the tasks in a group (a group owns none itself)
  tb proc logs <name> [-n lines] [--task <task>]   the last lines of a process's output
  tb proc stop <name> [--remove] | tb proc restart <name>   [--task <task>]
  tb browser [status|tabs|open <url>|start|stop] [--task <task>]
                                     your task's own Chrome, shown in Taskboard (agents use the task-browser MCP tools)
<task> is a number (12 or #12) or a task id.`;

// Options of the process and browser commands, read from the words before "--" only, so the command itself keeps
// its own flags.
function runtimeArgs(words, withValue) {
  const opts = {}, pos = [];
  for (let i = 0; i < words.length; i++) {
    const w = words[i];
    if (withValue.includes(w)) { opts[w.slice(2)] = words[++i]; continue; }
    if (w === '--remove' || w === '-n') { if (w === '-n') opts.n = words[++i]; else opts.remove = true; continue; }
    pos.push(w);
  }
  return { opts, pos };
}
// /api/tasks/<id>: --task <ref>, else the task this shell belongs to. Each task owns its processes; a group owns none.
async function runtimeOwner(opts) {
  if (opts.group) { console.error('tb: a group does not own processes. Each task owns its own. Give --task <task>, or run it inside the task.'); process.exit(1); }
  const ref = opts.task || process.env.TASK_ID;
  if (!ref) { console.error('tb: run this inside a Taskboard task, or give --task <task>.'); process.exit(1); }
  const t = await task(ref);
  return { path: `/api/tasks/${encodeURIComponent(t.id)}`, label: `#${t.num}`, task: t };
}
const shellWord = w => /^[A-Za-z0-9_@%+=:,./-]+$/.test(w) ? w : `'${w.replace(/'/g, `'\\''`)}'`;
const procLine = p => `${p.name.padEnd(14)} ${p.state.padEnd(9)} ${(p.port ? ':' + p.port : '').padEnd(7)} ${p.command}${p.exitCode !== undefined && p.state === 'exited' ? `  (exit ${p.exitCode})` : ''}${p.stopNote ? `  — ${p.stopNote}` : ''}`;

const [cmd, ...rest] = args;
switch (cmd) {
  case 'run': {
    const sep = rest.indexOf('--');
    const before = sep >= 0 ? rest.slice(0, sep) : rest;
    const { opts, pos } = runtimeArgs(before, ['--group', '--task', '--stop', '--port', '--cwd']);
    const name = pos[0];
    const cmdWords = sep >= 0 ? rest.slice(sep + 1) : pos.slice(1);
    if (!name || !cmdWords.length) { console.error('Usage: tb run [--port n] [--stop "<command>"] [--cwd dir] <name> -- <command…>'); process.exit(1); }
    const command = cmdWords.length === 1 ? cmdWords[0] : cmdWords.map(shellWord).join(' ');
    const o = await runtimeOwner(opts);
    const p = await call('POST', `${o.path}/procs`, { name, command, cwd: resolve(opts.cwd || process.cwd()), stop: opts.stop, port: opts.port, path: process.env.PATH });
    console.log(`Started ${p.name} for ${o.label} in ${p.cwd} (tmux window ${p.window})${p.port ? `, port ${p.port}` : ''}. Output: tb proc logs ${p.name}${opts.task ? ` --task ${opts.task}` : ''}.`);
    break;
  }
  case 'ps': {
    const { opts } = runtimeArgs(rest, ['--group', '--task']);
    if (opts.group) {
      // the items of the group's tasks, each with the task that owns it
      const g = (await call('GET', '/api/groups')).find(x => x.name === opts.group || x.id === opts.group);
      if (!g) { console.error(`tb: no group ${opts.group}`); process.exit(1); }
      const r = await call('GET', `/api/runtime?tasks=${g.tasks.map(encodeURIComponent).join(',')}`);
      if (has('--json')) { console.log(JSON.stringify(r, null, 2)); break; }
      const nums = Object.fromEntries((await tasks()).map(t => [t.id, t.num]));
      const line = i => `#${String(nums[i.task] ?? '?').padEnd(5)} ${i.kind === 'browser' ? 'browser' : 'process'} ${i.name.padEnd(14)} ${i.state.padEnd(9)} ${(i.port && i.kind === 'proc' ? ':' + i.port : '').padEnd(7)} ${i.memMb ? i.memMb + ' MB' : ''}`;
      console.log(r.items.length ? r.items.map(line).join('\n') : `No browsers or processes in the tasks of group ${g.name}.`);
      console.log(`Running in group ${g.name}: ${r.total.browsers} browser(s), ${r.total.procs} process(es), about ${r.total.memMb} MB (RSS).`);
      break;
    }
    const o = await runtimeOwner(opts);
    const list = await call('GET', `${o.path}/procs`);
    if (has('--json')) { console.log(JSON.stringify(list, null, 2)); break; }
    console.log(list.length ? list.map(procLine).join('\n') : `No processes for ${o.label}. Start one with tb run <name> -- <command>.`);
    break;
  }
  // tb proc logs|stop|restart <name>. ("tb restart" alone restarts Taskboard itself, so process commands have their own word.)
  case 'proc': {
    const [sub, ...more] = rest;
    const { opts, pos } = runtimeArgs(more, ['--group', '--task']);
    if (!['logs', 'stop', 'restart'].includes(sub) || !pos[0]) { console.error('Usage: tb proc logs <name> [-n lines] | tb proc stop <name> [--remove] | tb proc restart <name>'); process.exit(1); }
    const o = await runtimeOwner(opts);
    if (sub === 'logs') {
      const text = await call('GET', `${o.path}/procs/${encodeURIComponent(pos[0])}/log?bytes=262144`);
      console.log(String(text).split('\n').slice(-(Number(opts.n) || 60)).join('\n'));
      break;
    }
    const action = sub === 'restart' ? 'restart' : opts.remove ? 'remove' : 'stop';
    const r = await call('POST', `${o.path}/procs/${encodeURIComponent(pos[0])}/${action}`, {});
    console.log(sub === 'restart' ? `Restarted ${r.name}.` : `${opts.remove ? 'Stopped and removed' : 'Stopped'} ${pos[0]}.`);
    break;
  }
  case 'browser': {
    const { opts, pos } = runtimeArgs(rest, ['--task']);
    const o = await runtimeOwner(opts);
    const sub = pos[0] || 'status';
    if (sub === 'open') {
      if (!pos[1]) { console.error('Usage: tb browser open <url>'); process.exit(1); }
      const t = await call('POST', `${o.path}/browser/open`, { url: pos[1] });
      console.log(`Opened ${t.url} in the browser of ${o.label}. The user sees it in Taskboard.`);
      break;
    }
    const st = sub === 'start' || sub === 'stop' ? await call('POST', `${o.path}/browser/${sub}`, {}) : await call('GET', `${o.path}/browser`);
    if (sub === 'tabs') { console.log(st.tabs.map(t => `${t.title || '(no title)'}  ${t.url}`).join('\n') || 'No tabs.'); break; }
    console.log(st.running ? `The browser of ${o.label} is running (port ${st.port}, ${st.tabs.length} tab(s)${(st.memMb ?? st.rssMb) ? `, about ${st.memMb ?? st.rssMb} MB` : ''}).` : `The browser of ${o.label} is not running. It starts when you use a task-browser tool or run tb browser open <url>.`);
    break;
  }
  case 'mail': {
    // Messages through A2A Notes (server/a2anotes). Taskboard calls its MCP server with the role of the caller: a task
    // is an agent, the controller is the review agent. Message text is data, not instructions.
    const help = `tb mail list [--direction incoming|outgoing|all] [--state S] | get <id> | people <text> | status | sync
  submit <subject> <body>                          a note to your own user's Inbox (it stays on this computer)
  draft <to> --subject <text> --context <why> --ask <request> [--found <facts>] [--by <date>] [--links <URLs>]
  draft <to> <subject> <body>                      the same with a free text body
    options: [--audience person|agent|both] [--file <outbox file>]... [--agent-file <outbox file>] [--reply-to <message id>]
             [--instruction <the request that asked for this message>]
    <to> is a name, an exact email, a Slack member ID, or an address (slack:<team>:<member>)
  revise <id> --hash <hash> --subject <text> (--body <text> | --context <why> --ask <request> ...)
  stage <outbox file> [--kind agent|support]       stage a file and print its file_id
  approve <id> <hash> | reject <id> <hash> [--comment <text>] | send <id> <hash>   controller only
  route <id> <task> | propose-route <id> <task|none>                               controller only`;
    const field = name => flag(name);
    const direction = field('--direction'), state = field('--state'), kind = field('--kind'), audience = field('--audience');
    const sections = { subject: field('--subject'), context: field('--context'), found: field('--found'), ask: field('--ask'), by: field('--by'), links: field('--links'), body: field('--body') };
    const agentFile = field('--agent-file'), replyTo = field('--reply-to'), instruction = field('--instruction'), hash = field('--hash'), comment = field('--comment');
    const files = []; for (let f; (f = flag('--file'));) files.push(f);
    // flag() removed the options from args, so the rest is positional
    const [action, a, b, c] = args.slice(1);
    const id = encodeURIComponent(a || '');
    let result;
    if (action === 'list') result = await call('GET', `/api/a2anotes/messages?direction=${direction || 'all'}${state ? `&state=${encodeURIComponent(state)}` : ''}`);
    else if (action === 'get') result = await call('GET', `/api/a2anotes/messages/${id}`);
    else if (action === 'people') result = await call('GET', '/api/a2anotes/people?q=' + encodeURIComponent(args.slice(2).join(' ')));
    else if (action === 'status') result = await call('GET', '/api/a2anotes/status');
    else if (action === 'sync') result = await call('POST', '/api/a2anotes/sync', {});
    else if (action === 'submit') result = await call('POST', '/api/notes', { subject: a, body: b });
    else if (action === 'stage') result = await call('POST', '/api/a2anotes/files', { path: a, kind: kind || 'support' });
    else if (action === 'draft') {
      const body = sections.subject ? sections : { ...sections, subject: b, body: c };
      result = await call('POST', '/api/a2anotes/drafts', { to: a, ...body, ...(audience ? { audience } : {}), files, ...(agentFile ? { agent_file_path: agentFile } : {}), reply_to: replyTo, instruction });
    }
    else if (action === 'revise') result = await call('POST', `/api/a2anotes/messages/${id}/revise`, { hash, ...sections, ...(audience ? { audience } : {}), files, ...(agentFile ? { agent_file_path: agentFile } : {}) });
    else if (action === 'approve' || action === 'reject') result = await call('POST', `/api/a2anotes/messages/${id}/approve`, { hash: b, decision: action, ...(comment ? { comment } : {}) });
    else if (action === 'send') result = await call('POST', `/api/a2anotes/messages/${id}/send`, { hash: b });
    else if (action === 'route') result = await call('POST', `/api/a2anotes/messages/${id}/route`, { task: (await task(b)).id });
    else if (action === 'propose-route') result = await call('POST', `/api/a2anotes/messages/${id}/propose-route`, { task: b === 'none' ? null : (await task(b)).id });
    else { console.error(help); process.exit(1); }
    if (result?.body_check?.flags?.length) console.error(`The message check found ${result.body_check.flags.length} item(s). The user must approve this draft.`, ...result.body_check.flags.map(f => `\n- ${f.reason}${f.text && f.code !== 'ask_changed' && f.code !== 'check_failed' ? ` Text: ${f.text}` : ''}`));
    if (result?.body_check?.state === 'checking') console.error('The message check is still running. Read the draft again with tb mail get <id> in a minute.');
    console.log(JSON.stringify(result, null, 2)); break;
  }
  case 'info': {
    const i = await call('GET', '/api/info');
    console.log(`Machine:     ${i.machine} (host ${i.host})`);
    console.log(`Taskboard:   ${i.url} · process ${i.pid} · ${i.tasks} tasks`);
    if (i.controller) console.log(`Controller:  “${i.controller.label}” · ${i.controller.agent} · ${i.controller.status}${i.controller.remoteUrl ? `\nRemote:      ${i.controller.remoteUrl}` : ''}`);
    else console.log('Controller:  not started');
    break;
  }
  case 'list': {
    const status = flag('--status'), group = flag('--group'), json = has('--json');
    let list = (await tasks()).filter(t => t.status !== 'archived');
    if (status) list = list.filter(t => status.split(',').includes(t.status));
    if (group) { const g = (await call('GET', '/api/groups')).find(x => x.name === group || x.id === group); list = list.filter(t => g && g.tasks.includes(t.id)); }
    console.log(json ? JSON.stringify(list, null, 2) : list.map(line).join('\n') || 'No tasks.');
    break;
  }
  case 'accounts': {
    const list = await call('GET', '/api/accounts');
    const json = has('--json');
    if (json) console.log(JSON.stringify(list, null, 2));
    else {
      const info = await call('GET', '/api/info');
      const lines = list.map(a => {
        const windows = (a.usage?.windows || []).map(w => `${w.label} ${w.resetsAt && w.resetsAt < Date.now() ? 'reset' : w.usedPct + '%'}${w.resetsAt ? ` (resets ${new Date(w.resetsAt).toISOString()})` : ''}`).join(', ');
        return `${a.id} (${a.name}; ${a.agent}): ${a.status.signedIn ? 'signed in' : 'not signed in'}; ${a.running}/${a.maxParallel} tasks; ${a.limited ? 'limited; ' : ''}${windows || 'usage unknown'}; as of ${a.usage?.at || 'unknown'}${a.routingRules ? `; rule: ${a.routingRules}` : ''}`;
      });
      console.log(`Machine rules: ${info.settings.routingRules || '(none)'}\n${lines.join('\n')}`);
    }
    break;
  }
  case 'show': {
    const t = await task(rest[0]); const log = await call('GET', `/api/tasks/${t.id}/log`);
    console.log(`${line(t)}\nfolder: ${t.cwd}\ngoal: ${t.goal || t.title}\nnow: ${t.now || '—'}\nstatus: ${t.statusSource}\n\nLast log entry:\n${String(log).split(/\n(?=## )/).pop()}`);
    break;
  }
  case 'log': {
    const last = Number(flag('--last', '3'));
    for (const r of args.slice(1)) { const t = await task(r); const log = String(await call('GET', `/api/tasks/${t.id}/log`)); console.log(`=== #${t.num} ${t.title}\n` + log.split(/\n(?=## )/).slice(-last).join('\n')); }
    break;
  }
  case 'tail': {
    const n = flag('-n', '30'); const t = await task(args[1]);
    console.log(await call('GET', `/api/tasks/${t.id}/peek?lines=${n}`));
    break;
  }
  case 'result': {
    const t = await task(rest[0]); const d = await call('GET', `/api/tasks/${t.id}/docs`);
    console.log(`#${t.num} ${t.title} — ${t.status}\n\n${t.now || '(no message yet)'}\n\nOutbox:\n${d.outbox.map(x => '  ' + x.path).join('\n') || '  (empty)'}`);
    break;
  }
  case 'wait': {
    const until = flag('--until', 'done'), timeout = Number(flag('--timeout', '3600')) * 1000;
    const refs = args.slice(1), ids = []; for (const r of refs) ids.push((await task(r)).id);
    const done = s => ['unread', 'idle', 'suspended', 'archived', 'parked', 'stopped'].includes(s);
    const needs = s => ['needs-you', 'stopped', 'review'].includes(s);
    const start = Date.now();
    for (;;) {
      tasksCache = undefined; const all = await tasks(); const ts = ids.map(id => all.find(t => t.id === id));
      const hit = ts.filter(t => until === 'needs-you' ? needs(t.status) : until === 'any' ? (done(t.status) || needs(t.status)) : done(t.status));
      if (until === 'done' ? hit.length === ts.length : hit.length) { console.log(hit.map(line).join('\n')); break; }
      if (Date.now() - start > timeout) { console.log('tb wait: timed out\n' + ts.map(line).join('\n')); process.exit(2); }
      await sleep(3000);
    }
    break;
  }
  case 'move': {
    const account = flag('--account'), instruction = flag('--instruction', '');
    if (!account || args.length !== 2 || args[1].startsWith('--')) { console.error('Usage: tb move <task> --account <id> [--instruction "<text>"]'); process.exit(1); }
    const t = await task(args[1]);
    const moved = await call('POST', `/api/tasks/${t.id}/move-account`, { account, instruction });
    if (!moved.approved) console.log(`Moved #${moved.num} to ${moved.account} (${moved.agent}). ${moved.statusSource}`);
    break;
  }
  case 'send': {
    const text = rest.slice(1).join(' ');
    if (!text.trim()) { console.error('tb send: the text is empty. Nothing was sent, and Enter was not pressed.'); process.exit(1); }
    const t = await task(rest[0]); const r = await call('POST', `/api/tasks/${t.id}/send`, { text });
    if (r?.approved) break;
    console.log(`Sent to #${t.num}.${r?.warning ? ` ${r.warning}` : ''}`);
    break;
  }
  case 'new': {
    const batch = flag('--batch');
    const specs = batch ? JSON.parse(readFileSync(batch, 'utf8')) : [{ agent: flag('--agent', 'claude'), account: flag('--account'), model: flag('--model'), folder: flag('--folder'), title: flag('--title'), worktree: has('--no-worktree') ? false : flag('--worktree'), group: flag('--group'), prompt: args.slice(1).join(' ') }];
    for (const s of specs) {
      if (!s.folder || !s.prompt) { console.error('tb new: --folder and a prompt are required'); process.exit(1); }
      const t = await call('POST', '/api/tasks', { title: s.title || s.prompt.slice(0, 60), desc: s.prompt, agent: s.agent || 'claude', folder: resolve(s.folder.replace(/^~/, homedir())), worktree: s.worktree === false ? false : s.worktree ? true : undefined, branch: typeof s.worktree === 'string' ? s.worktree : undefined, parent: process.env.TASK_ID || undefined, group: s.group || undefined, account: s.account || undefined, model: s.model || undefined });
      if (t.approved) continue;
      console.log(`Started #${t.num} ${t.title} (${t.agent} on ${t.account}) in ${t.cwd}`);
    }
    break;
  }
  case 'ask': {
    if (rest[0] !== 'spin-off' || !rest[1]) { console.error('Usage: tb ask spin-off <task> [--answer n] [--title <t>] [--agent <name>] [--account <id>] [--folder <path>] [--worktree <branch>]'); process.exit(1); }
    const source = await task(rest[1]);
    const thread = await call('GET', `/api/tasks/${encodeURIComponent(source.id)}/ask`);
    const answer = flag('--answer');
    const index = answer === undefined ? thread.items.findLastIndex(x => x.state === 'done') : Number(answer) - 1;
    const item = thread.items[index];
    if (!item || item.state !== 'done' || !item.a) { console.error('tb ask spin-off: select a completed answer'); process.exit(1); }
    const title = flag('--title', item.q.slice(0, 80));
    const agent = flag('--agent', source.agent);
    const account = flag('--account', 'auto');
    const folder = flag('--folder', source.folder);
    const worktree = flag('--worktree');
    const created = await call('POST', '/api/tasks', { title, agent, account, folder: resolve(folder.replace(/^~/, homedir())), worktree: worktree ? true : undefined, branch: worktree, spinOff: { sourceNum: source.num, question: item.q, answer: item.a } });
    if (!created.approved) console.log(`Started #${created.num} ${created.title} (${created.agent}) in ${created.cwd}`);
    break;
  }
  case 'group': {
    const [sub, name, ...refs] = rest; const gs = await call('GET', '/api/groups');
    if (sub === 'list') { console.log(gs.map(g => `${g.name} (${g.tasks.length})`).join('\n') || 'No groups.'); break; }
    let g = gs.find(x => x.name === name || x.id === name);
    if (!g && sub === 'add') g = await call('POST', '/api/groups', { name });
    if (!g) { console.error(`tb: no group ${name}`); process.exit(1); }
    const ids = []; for (const r of refs) ids.push((await task(r)).id);
    await call('PATCH', `/api/groups/${g.id}`, sub === 'add' ? { add: ids } : { remove: ids });
    console.log(`${g.name}: ${sub === 'add' ? 'added' : 'removed'} ${refs.join(', ')}`);
    break;
  }
  case 'doc': {
    if (rest[0] !== 'send') { console.log(HELP); break; }
    const [src, dst] = rest.slice(1); const [fromRef, name] = src.split(':');
    const from = await task(fromRef), to = await task(dst);
    const r = await call('POST', '/api/docs/send', { from: from.id, name, to: to.id }); console.log(`Copied to ${r.path}`);
    break;
  }
  case 'inbox': {
    if (rest[0] !== 'wait') { console.log(HELP); break; }
    const id = process.env.TASK_ID; if (!id) { console.error('tb inbox wait: TASK_ID is not set (run it inside a Taskboard task)'); process.exit(1); }
    const timeout = Number(flag('--timeout', '3600')) * 1000, start = Date.now();
    const sender = f => !f ? 'unknown sender' : f.task === 'you' ? 'the user' : f.task === '__review' ? 'the user Inbox (the user\'s comments)' : f.num ? `task #${f.num} "${f.title}"` : `task ${f.task}`;
    for (;;) {
      const { files } = await call('POST', `/api/tasks/${id}/inbox/take`);
      if (files.length) { console.log(files.map(f => `${f.path}  (from ${sender(f.from)})`).join('\n')); break; }
      if (Date.now() - start >= timeout) { console.log('tb inbox wait: timed out, no new files'); process.exit(2); }
      await sleep(Math.min(2000, Math.max(0, timeout - (Date.now() - start))));
    }
    break;
  }
  case 'review': {
    const path = resolve(rest[0] || ''); await call('POST', '/api/review/request', { path, task: process.env.TASK_ID });
    console.log('Marked for review. The user sees it on the user Inbox; their comments will arrive in your inbox.');
    break;
  }
  case 'release-request': {
    if (!process.env.TASK_ID) { console.error('tb release-request: run this inside a Taskboard task'); process.exit(1); }
    await call('POST', '/api/release/request', {});
    break;
  }
  case 'restart': {
    // The user runs scripts/restart.mjs of the installed release. A task cannot restart Taskboard. The controller puts an
    // Approve card on the dashboard and waits for the new server.
    const id = process.env.TASK_ID;
    if (id && id !== 'controller') { console.error('tb restart: only the user restarts Taskboard, from the dashboard (Settings → Taskboard server) or a terminal. Tell the user why a restart is needed.'); process.exit(1); }
    if (id === 'controller') {
      const before = await call('GET', '/api/info');
      await call('POST', '/api/restart/request', {});
      const end = Date.now() + 120000;
      for (;;) {
        await sleep(2000);
        const now = await fetch(URL_BASE + '/api/info', { signal: AbortSignal.timeout(2000) }).then(r => r.ok ? r.json() : null).catch(() => null);
        if (now && now.pid !== before.pid) { console.log(`Taskboard restarted: process ${now.pid} answers at ${URL_BASE}.`); break; }
        if (Date.now() > end) { console.error(`tb restart: no new server answered within 2 minutes. Read ${join(homedir(), '.taskboard', 'restart.log')}.`); process.exit(1); }
      }
      break;
    }
    // a sandbox has no installed release: use the script next to this tb (a checkout)
    const script = process.env.TASKBOARD_DIR ? join(dirname(fileURLToPath(import.meta.url)), '..', 'scripts', 'restart.mjs') : join(homedir(), '.taskboard', 'app', 'scripts', 'restart.mjs');
    const r = spawnSync(process.execPath, [script, ...args.slice(1)], { stdio: 'inherit' });
    if (r.error) console.error(`tb restart: cannot run ${script}: ${r.error.message}`);
    process.exit(r.status ?? 1);
  }
  case 'suggest':
  case 'permit': {
    const action = args[0] === 'suggest' ? 'request' : rest[0];
    if (action === 'request') {
      if (!process.env.TASK_ID || process.env.TASK_ID === 'controller') { console.error('tb permit request: run this inside a task'); process.exit(1); }
      const reason = flag('--why') || flag('--reason');
      const command = args[0] === 'suggest' ? (flag('--command') || (rest[0]?.startsWith('--') ? undefined : rest[0])) : flag('--command');
      const risk = flag('--risk') || '';
      const cwd = flag('--cwd');
      const timeout = flag('--timeout');
      const stepsFile = flag('--steps');
      const network = has('--network');
      if (!reason || (!!command === !!stepsFile)) { console.error('tb permit request: give --reason and exactly one of --command or --steps'); process.exit(1); }
      if (stepsFile && (cwd || timeout || network)) { console.error('tb permit request: set the directory, timeout, and network flag in each step'); process.exit(1); }
      const steps = stepsFile ? JSON.parse(readFileSync(resolve(stepsFile), 'utf8')).steps : [{ command, ...(cwd ? { cwd: resolve(cwd) } : {}), ...(timeout ? { timeoutSeconds: Number(timeout) } : {}), network }];
      const result = await call('POST', '/api/permits', { reason, steps, risk });
      if (result.push) console.log(`${result.message} Push ${result.push.id}: ${result.push.state}. Read it with tb git push-result ${result.push.id} --wait.`);
      else if (result.permit) console.log(`Permit ${result.permit.id} waits on the dashboard. Read it with tb permit result ${result.permit.id} --wait.`);
      else console.log('This needs a release request: run tb release-request. The release card was decided.');
    } else if (action === 'result') {
      const id = rest[1]; if (!id) { console.error('tb permit result: give an ID'); process.exit(1); }
      const wait = has('--wait');
      for (;;) {
        const p = await call('GET', `/api/permits/${encodeURIComponent(id)}`);
        if (!wait || !['pending', 'running'].includes(p.state)) {
          console.log(JSON.stringify(p, null, 2));
          if (wait && p.state !== 'succeeded') process.exitCode = 3;
          break;
        }
        await sleep(2000);
      }
    } else if (action === 'list') console.log(JSON.stringify(await call('GET', '/api/permits'), null, 2));
    else if (action === 'approve') {
      if (process.env.TASK_ID !== 'controller') { console.error('tb permit approve: controller only'); process.exit(1); }
      const userRequest = flag('--user-request');
      if (!rest[1]) { console.error('tb permit approve ID [--user-request "the user chat message for high risk"]'); process.exit(1); }
      console.log(JSON.stringify(await call('POST', `/api/permits/${encodeURIComponent(rest[1])}/controller-approve`, { userRequest }), null, 2));
    } else { console.error('tb permit request | result | list | approve'); process.exit(1); }
    break;
  }
  case 'git': {
    if (!process.env.TASK_ID) { console.error('tb git: run this inside a Taskboard task'); process.exit(1); }
    if (rest[0] === 'merge-request') await call('POST', '/api/git/merge-request', {});
    else if (rest[0] === 'commit') console.log((await call('POST', '/api/git/commit', { message: rest.slice(1).join(' ') })).result);
    else if (rest[0] === 'rebase') {
      if (rest.length > 2 || (rest[1]?.startsWith('-') && !['--continue', '--abort'].includes(rest[1]))) { console.error('tb git rebase: run tb git rebase [BASE], tb git rebase --continue, or tb git rebase --abort.'); process.exit(1); }
      const action = rest[1] === '--continue' ? 'continue' : rest[1] === '--abort' ? 'abort' : 'start';
      console.log((await call('POST', '/api/git/rebase', { action, ...(action === 'start' && rest[1] ? { base: rest[1] } : {}) })).result);
    }
    else if (rest[0] === 'repair') {
      const base = flag('--base'); const message = flag('-m'); const commit = flag('--drop'); const backup = flag('--restore');
      const squash = has('--squash'); const list = has('--list');
      const modes = [squash, !!commit, !!backup, list].filter(Boolean).length;
      if (modes !== 1 || args.length > 2) { console.error('tb git repair: run --squash --base BASE -m "message", --drop COMMIT [--base BASE], --restore BACKUP, or --list.'); process.exit(1); }
      const mode = squash ? 'squash' : commit ? 'drop' : backup ? 'restore' : 'list';
      console.log((await call('POST', '/api/git/repair', { mode, base, message, commit, backup })).result);
    }
    else if (rest[0] === 'check') {
      const base = flag('--base');
      if (args.length > 2) { console.error('tb git check: run tb git check [--base BASE].'); process.exit(1); }
      console.log((await call('POST', '/api/git/check', { base })).result);
    }
    else if (rest[0] === 'push-request') {
      if (rest.some(x => /^(--force|--delete|--tags|--mirror|--all)(?:$|[=-])/.test(x))) { console.error('tb git push-request: force pushes, deletions, and tags are not allowed'); process.exit(1); }
      const reason = flag('--reason', ''); const branch = flag('--branch', undefined); const remote = flag('--remote', 'origin'); const base = flag('--base', undefined); const thenRelease = has('--then-release');
      if (!reason) { console.error('tb git push-request: give --reason'); process.exit(1); }
      const result = await call('POST', '/api/git/push-request', { reason, branch, remote, base, thenRelease });
      console.log(`Push ${result.push.id}: ${result.push.state}. Read it with tb git push-result ${result.push.id} --wait.`);
    } else if (rest[0] === 'push-result') {
      const id = rest[1]; if (!id) { console.error('tb git push-result: give an ID'); process.exit(1); }
      const wait = has('--wait');
      for (;;) {
        const result = await call('GET', `/api/git/pushes/${encodeURIComponent(id)}`);
        if (result.state !== 'pending' || !wait) { console.log(JSON.stringify(result, null, 2)); break; }
        await new Promise(resolve => setTimeout(resolve, 2000));
      }
    } else { console.error('Run tb git commit, tb git rebase, tb git repair, tb git check, tb git merge-request, tb git push-request, or tb git push-result.'); process.exit(1); }
    break;
  }
  case 'park': { const t = await task(rest[0]); await call('POST', `/api/tasks/${t.id}/status`, { status: 'parked' }); console.log(`#${t.num} set aside.`); break; }
  case 'resume': {
    if (rest.length !== 1 || !rest[0]) { console.error('Usage: tb resume <task>'); process.exit(1); }
    const t = await task(rest[0]);
    const resumed = await call('POST', `/api/tasks/${t.id}/status`, { status: 'idle' });
    console.log(`#${t.num} resumed. Status: ${resumed.status}. Run tb send ${t.num} "<text>" to send an instruction.`);
    break;
  }
  // archive = done: ends the agent's session too (otherwise its next turn would bring the task back)
  case 'archive': { const t = await task(rest[0]); await call('POST', `/api/tasks/${t.id}/kill`, {}); console.log(`#${t.num} ended and archived.`); break; }
  default: console.log(HELP);
}
