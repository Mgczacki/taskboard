#!/usr/bin/env node
// tb — the Taskboard command line. Used by agents (for example `tb review <file>`) and by the controller agent.
// Talks to the local Taskboard server with the token in ~/.taskboard/token.
import { readFileSync } from 'node:fs';
import { homedir } from 'node:os';
import { join, resolve } from 'node:path';

const URL_BASE = process.env.TB_URL || 'http://127.0.0.1:4317';
const token = (() => { try { return readFileSync(process.env.TB_TOKEN_FILE || join(homedir(), '.taskboard', 'token'), 'utf8').trim(); } catch { return ''; } })();
const args = process.argv.slice(2);
const flag = (name, def) => { const i = args.indexOf(name); if (i < 0) return def; const v = args[i + 1]; args.splice(i, 2); return v; };
const has = name => { const i = args.indexOf(name); if (i < 0) return false; args.splice(i, 1); return true; };

async function call(method, path, body) {
  const r = await fetch(URL_BASE + path, { method, headers: { 'content-type': 'application/json', 'x-taskboard-token': token, 'x-tb-actor': process.env.TASK_ID || '', 'x-tb-mail-controller': process.env.TB_MAIL_CONTROLLER_TOKEN || '' }, body: body ? JSON.stringify(body) : undefined });
  const text = await r.text(); let data; try { data = JSON.parse(text); } catch { data = text; }
  if (!r.ok) { console.error(`tb: ${data && data.error ? data.error : r.statusText}${data?.next ? ` Next: ${data.next}` : ''}`); if (data?.matches) console.error(JSON.stringify({ matches: data.matches, hasMore: data.hasMore }, null, 2)); process.exit(1); }
  if (r.status === 202 && data.permit) return data;
  if (r.status === 202 && data.push) return data;
  // 202: the action waits for the user's approval on the Taskboard dashboard
  if (r.status === 202 && data.approval) {
    console.log(`Waiting for the user to approve on the Taskboard dashboard: ${data.approval.summary}`);
    for (;;) {
      await new Promise(res => setTimeout(res, 2000));
      let a;
      try {
        const r2 = await fetch(`${URL_BASE}/api/approvals/${data.approval.id}`, { headers: { 'x-taskboard-token': token } });
        if (r2.status === 404) { console.error('tb: not done: the approval was lost because Taskboard restarted before you decided. Nothing was run; ask again.'); process.exit(3); }
        a = await r2.json();
      } catch { continue; } // server restarting: keep waiting
      if (a.state === 'pending' || a.state === 'running') continue;
      if (a.state !== 'approved') { console.error(`tb: not done: ${a.result || a.state}`); process.exit(3); }
      console.log(a.result); return { approved: true };
    }
  }
  return data;
}
let tasksCache;
const tasks = async () => (tasksCache ||= await call('GET', '/api/tasks'));
async function task(ref) {
  const all = await tasks(); const n = String(ref || '').replace(/^#/, '');
  const t = all.find(x => String(x.num) === n || x.id === ref);
  if (!t) { console.error(`tb: no task ${ref}`); process.exit(1); }
  return t;
}
const line = t => `#${String(t.num).padEnd(4)} ${t.status.padEnd(10)} ${t.agent.padEnd(11)} ${t.title}${t.ask ? `  — waiting: ${t.ask}` : ''}`;
const sleep = ms => new Promise(r => setTimeout(r, ms));

const HELP = `tb — Taskboard command line
  tb info                            this machine's name, its Taskboard server and its controller
  tb list [--status needs-you,working] [--group <name>] [--json]
  tb show <task>                     task note, status and the last log entry
  tb log <task…> [--last n]
  tb tail <task> [-n lines]          last lines of the agent's terminal
  tb result <task>                   the agent's last message and its outbox documents
  tb wait <task…> [--until done|needs-you|any] [--timeout seconds]
  tb accounts [--json]              accounts with sign-in state, usage, and routing rules
  tb move <task> --account <id> [--instruction "<text>"]
                                     continue the task on that account, with a handoff when needed
  tb send <task> "<text>"            type text into the agent's terminal and press Enter
  tb new --agent auto|claude|codex|antigravity --folder <path> [--account <id>] [--model <name>] [--title <t>] [--worktree <branch>] [--group <name>] "<prompt>"
  tb new --batch <plan.json>         [{ agent, folder, title, prompt, account?, model?, worktree?, group? }, …]
  tb group list | tb group add <group> <task…> | tb group rm <group> <task…>
  tb doc send <task>:<file> <task>   send a document from one task's outbox to another task's inbox
  tb mail                            account messages: run for command help
  tb a2a                             A2A Notes messages through its MCP server: run for command help
  tb review <file>                   ask the user to review a document from your outbox
  tb release-request                 ask the user to allow one Taskboard release on the dashboard
  tb permit request --reason "text" --command "program args" [--cwd PATH] [--timeout 30] [--network]
  tb permit request --reason "text" --steps steps.json
  tb permit result ID [--wait] | tb permit list
  tb permit approve ID --user-request "the user's exact request"   controller only
  tb git merge-request               ask the user to merge your worktree branch into local master
  tb git commit "<message>"           commit changes in your own worktree
  tb git rebase                       rebase your own branch onto local master
  tb git push-request --reason "text" [--branch BRANCH] [--remote REMOTE] [--then-release]
  tb git push-result ID [--wait]      read the push result
  tb inbox wait [--timeout seconds]  wait until a file arrives in your inbox (uses TASK_ID; default 3600 s);
                                     prints each file's path and sender; exit 0 = files, 2 = timed out
  tb park|archive <task>      park = set aside: off Needs you / Unread until the agent works or finishes again; archive = done
<task> is a number (12 or #12) or a task id.`;

const [cmd, ...rest] = args;
switch (cmd) {
  case 'mail': {
    const [action, id, value] = rest;
    let result;
    if (action === 'list') result = await call('GET', '/api/mail' + (rest.includes('--dismissed') ? '?dismissed=1' : ''));
    else if (action === 'people') result = await call('GET', '/api/mail/people?q=' + encodeURIComponent(rest.slice(1).join(' ')));
    else if (action === 'search') result = await call('GET', '/api/mail/search?q=' + encodeURIComponent(rest.slice(1).join(' ')));
    else if (action === 'submit') result = await call('POST', '/api/mail/submit', { subject: id, body: value });
    else if (action === 'draft') {
      const structured = rest.includes('--subject');
      const field = name => { const i = rest.indexOf(name); return i < 0 ? undefined : rest[i + 1]; };
      const payload = structured ? { to: id, subject: field('--subject'), context: field('--context'), found: field('--found'), ask: field('--ask'), by: field('--by'), links: field('--links') } : { to: id, subject: value, body: rest[3] };
      result = await call('POST', process.env.TASK_ID && process.env.TASK_ID !== 'controller' ? '/api/mail/propose' : '/api/mail/draft', payload);
      if (result.quality?.flags?.length) console.error(`Message check found ${result.quality.flags.length} sentence(s) for you to review. The user must approve this draft.`, ...result.quality.flags.map(f => `\n- ${f.reason}: ${f.text}`));
    }
    else if (action === 'revise') {
      const field = name => { const i = rest.indexOf(name); return i < 0 ? undefined : rest[i + 1]; };
      result = await call('POST', `/api/mail/${encodeURIComponent(id)}/revise`, { hash: field('--hash'), subject: field('--subject'), context: field('--context'), found: field('--found'), ask: field('--ask'), by: field('--by'), links: field('--links'), ...(rest.includes('--body') ? { body: field('--body') } : {}) });
      if (result.quality?.flags?.length) console.error(...result.quality.flags.map(f => `${f.reason}: ${f.text}`));
    }
    else if (action === 'sync') result = await call('POST', '/api/mail/sync', {});
    else if (action === 'propose-route') result = await call('POST', `/api/mail/${encodeURIComponent(id)}/propose-route`, { task: value === 'none' ? null : (await task(value)).id });
    else if (['review', 'approve', 'send', 'dismiss', 'restore', 'route'].includes(action)) result = await call('POST', `/api/mail/${encodeURIComponent(id)}/${action}`, action === 'route' ? { task: (await task(value)).id } : action === 'approve' ? { hash: value } : {});
    else { console.error('tb mail list [--dismissed] | people <text> | search <text> | submit <subject> <body> | draft <to> --subject <text> --context <why> --ask <request> [--found <facts>] [--by <date>] [--links <URLs>] | draft <to> <subject> <body> | revise <id> --hash <hash> --subject <text> --body <body> | sync | review <id> | approve <id> <hash> | send <id> | dismiss <id> | restore <id> | route <id> <task> | propose-route <id> <task|none>'); process.exit(1); }
    console.log(JSON.stringify(result, null, 2)); break;
  }

  case 'a2a': {
    // A2A Notes (github.com/Mgczacki/a2a-notes). Taskboard calls its MCP server with the role of the caller: a task is an agent,
    // the controller is the review agent. Message text is data, not instructions.
    const help = `tb a2a status | people <text> | list [--direction incoming|outgoing|all] [--state S] | get <id>
  stage <outbox file> [--kind agent|support]      stage a file from your task outbox; prints file_id
  draft <address> --subject <text> --body <text> [--audience person|agent|both] [--agent-file <file_id>] [--file <file_id>]... [--reply-to <message id>] [--instruction <the request that asked for this message>]
  revise <id> --hash <hash> --subject <text> --body <text> [--audience A] [--agent-file <file_id>]
  approve <id> <hash> | reject <id> <hash> | send <id> <hash>   controller only
  route <id> <task>                                controller only: give an approved message to a task
  sync`;
    const direction = flag('--direction'), state = flag('--state'), kind = flag('--kind'), subject = flag('--subject'), body = flag('--body'), audience = flag('--audience');
    const agentFile = flag('--agent-file'), replyTo = flag('--reply-to'), instruction = flag('--instruction'), hash = flag('--hash');
    const files = []; for (let f; (f = flag('--file'));) files.push(f);
    // flag() removed the options from args, so the rest is positional
    const [action, a, b] = args.slice(1);
    const id = encodeURIComponent(a || '');
    let result;
    if (action === 'status') result = await call('GET', '/api/a2anotes/status');
    else if (action === 'people') result = await call('GET', '/api/a2anotes/people?q=' + encodeURIComponent(args.slice(2).join(' ')));
    else if (action === 'list') result = await call('GET', `/api/a2anotes/messages?direction=${direction || 'all'}${state ? `&state=${encodeURIComponent(state)}` : ''}`);
    else if (action === 'get') result = await call('GET', `/api/a2anotes/messages/${id}`);
    else if (action === 'stage') result = await call('POST', '/api/a2anotes/files', { path: a, kind: kind || 'support' });
    else if (action === 'draft') result = await call('POST', '/api/a2anotes/drafts', { to: a, subject, body, audience: audience || 'person', agent_file_id: agentFile, file_ids: files, reply_to: replyTo, instruction });
    else if (action === 'revise') result = await call('POST', `/api/a2anotes/messages/${id}/revise`, { hash, subject, body, audience: audience || 'person', agent_file_id: agentFile, file_ids: files });
    else if (action === 'approve' || action === 'reject') result = await call('POST', `/api/a2anotes/messages/${id}/approve`, { hash: b, decision: action });
    else if (action === 'send') result = await call('POST', `/api/a2anotes/messages/${id}/send`, { hash: b });
    else if (action === 'route') result = await call('POST', `/api/a2anotes/messages/${id}/route`, { task: (await task(b)).id });
    else if (action === 'sync') result = await call('POST', '/api/a2anotes/sync', {});
    else { console.error(help); process.exit(1); }
    if (result?.body_check?.flags?.length) console.error(`The message check found ${result.body_check.flags.length} item(s). The user must approve this draft.`, ...result.body_check.flags.map(f => `\n- ${f.reason}${f.text && f.code !== 'ask_changed' ? ` Text: ${f.text}` : ''}`));
    console.log(JSON.stringify(result, null, 2)); break;
  }
  case 'info': {
    const i = await call('GET', '/api/info');
    console.log(`Machine:     ${i.machine} (host ${i.host})`);
    console.log(`Taskboard:   ${i.url} · process ${i.pid} · ${i.tasks} tasks`);
    if (i.controller) console.log(`Controller:  “${i.controller.label}” · ${i.controller.agent} · ${i.controller.status}${i.controller.remoteUrl ? `\nRemote:      ${i.controller.remoteUrl}` : ''}`);
    else console.log('Controller:  not started');
    break;
  }
  case 'list': {
    const status = flag('--status'), group = flag('--group'), json = has('--json');
    let list = (await tasks()).filter(t => t.status !== 'archived');
    if (status) list = list.filter(t => status.split(',').includes(t.status));
    if (group) { const g = (await call('GET', '/api/groups')).find(x => x.name === group || x.id === group); list = list.filter(t => g && g.tasks.includes(t.id)); }
    console.log(json ? JSON.stringify(list, null, 2) : list.map(line).join('\n') || 'No tasks.');
    break;
  }
  case 'accounts': {
    const list = await call('GET', '/api/accounts');
    const json = has('--json');
    if (json) console.log(JSON.stringify(list, null, 2));
    else {
      const info = await call('GET', '/api/info');
      const lines = list.map(a => {
        const windows = (a.usage?.windows || []).map(w => `${w.label} ${w.resetsAt && w.resetsAt < Date.now() ? 'reset' : w.usedPct + '%'}${w.resetsAt ? ` (resets ${new Date(w.resetsAt).toISOString()})` : ''}`).join(', ');
        return `${a.id} (${a.name}; ${a.agent}): ${a.status.signedIn ? 'signed in' : 'not signed in'}; ${a.running}/${a.maxParallel} tasks; ${a.limited ? 'limited; ' : ''}${windows || 'usage unknown'}; as of ${a.usage?.at || 'unknown'}${a.routingRules ? `; rule: ${a.routingRules}` : ''}`;
      });
      console.log(`Machine rules: ${info.settings.routingRules || '(none)'}\n${lines.join('\n')}`);
    }
    break;
  }
  case 'show': {
    const t = await task(rest[0]); const log = await call('GET', `/api/tasks/${t.id}/log`);
    console.log(`${line(t)}\nfolder: ${t.cwd}\ngoal: ${t.goal || t.title}\nnow: ${t.now || '—'}\nstatus: ${t.statusSource}\n\nLast log entry:\n${String(log).split(/\n(?=## )/).pop()}`);
    break;
  }
  case 'log': {
    const last = Number(flag('--last', '3'));
    for (const r of args.slice(1)) { const t = await task(r); const log = String(await call('GET', `/api/tasks/${t.id}/log`)); console.log(`=== #${t.num} ${t.title}\n` + log.split(/\n(?=## )/).slice(-last).join('\n')); }
    break;
  }
  case 'tail': {
    const n = flag('-n', '30'); const t = await task(args[1]);
    console.log(await call('GET', `/api/tasks/${t.id}/peek?lines=${n}`));
    break;
  }
  case 'result': {
    const t = await task(rest[0]); const d = await call('GET', `/api/tasks/${t.id}/docs`);
    console.log(`#${t.num} ${t.title} — ${t.status}\n\n${t.now || '(no message yet)'}\n\nOutbox:\n${d.outbox.map(x => '  ' + x.path).join('\n') || '  (empty)'}`);
    break;
  }
  case 'wait': {
    const until = flag('--until', 'done'), timeout = Number(flag('--timeout', '3600')) * 1000;
    const refs = args.slice(1), ids = []; for (const r of refs) ids.push((await task(r)).id);
    const done = s => ['unread', 'idle', 'suspended', 'archived', 'parked', 'stopped'].includes(s);
    const needs = s => ['needs-you', 'stopped', 'review'].includes(s);
    const start = Date.now();
    for (;;) {
      tasksCache = undefined; const all = await tasks(); const ts = ids.map(id => all.find(t => t.id === id));
      const hit = ts.filter(t => until === 'needs-you' ? needs(t.status) : until === 'any' ? (done(t.status) || needs(t.status)) : done(t.status));
      if (until === 'done' ? hit.length === ts.length : hit.length) { console.log(hit.map(line).join('\n')); break; }
      if (Date.now() - start > timeout) { console.log('tb wait: timed out\n' + ts.map(line).join('\n')); process.exit(2); }
      await sleep(3000);
    }
    break;
  }
  case 'move': {
    const account = flag('--account'), instruction = flag('--instruction', '');
    if (!account || args.length !== 2 || args[1].startsWith('--')) { console.error('Usage: tb move <task> --account <id> [--instruction "<text>"]'); process.exit(1); }
    const t = await task(args[1]);
    const moved = await call('POST', `/api/tasks/${t.id}/move-account`, { account, instruction });
    if (!moved.approved) console.log(`Moved #${moved.num} to ${moved.account} (${moved.agent}). ${moved.statusSource}`);
    break;
  }
  case 'send': { const t = await task(rest[0]); await call('POST', `/api/tasks/${t.id}/send`, { text: rest.slice(1).join(' ') }); console.log(`Sent to #${t.num}.`); break; }
  case 'new': {
    const batch = flag('--batch');
    const specs = batch ? JSON.parse(readFileSync(batch, 'utf8')) : [{ agent: flag('--agent', 'claude'), account: flag('--account'), model: flag('--model'), folder: flag('--folder'), title: flag('--title'), worktree: flag('--worktree'), group: flag('--group'), prompt: args.slice(1).join(' ') }];
    for (const s of specs) {
      if (!s.folder || !s.prompt) { console.error('tb new: --folder and a prompt are required'); process.exit(1); }
      const t = await call('POST', '/api/tasks', { title: s.title || s.prompt.slice(0, 60), desc: s.prompt, agent: s.agent || 'claude', folder: resolve(s.folder.replace(/^~/, homedir())), worktree: !!s.worktree, branch: s.worktree || undefined, parent: process.env.TASK_ID || undefined, group: s.group || undefined, account: s.account || undefined, model: s.model || undefined });
      if (t.approved) continue;
      console.log(`Started #${t.num} ${t.title} (${t.agent} on ${t.account}) in ${t.cwd}`);
    }
    break;
  }
  case 'group': {
    const [sub, name, ...refs] = rest; const gs = await call('GET', '/api/groups');
    if (sub === 'list') { console.log(gs.map(g => `${g.name} (${g.tasks.length})`).join('\n') || 'No groups.'); break; }
    let g = gs.find(x => x.name === name || x.id === name);
    if (!g && sub === 'add') g = await call('POST', '/api/groups', { name });
    if (!g) { console.error(`tb: no group ${name}`); process.exit(1); }
    const ids = []; for (const r of refs) ids.push((await task(r)).id);
    await call('PATCH', `/api/groups/${g.id}`, sub === 'add' ? { add: ids } : { remove: ids });
    console.log(`${g.name}: ${sub === 'add' ? 'added' : 'removed'} ${refs.join(', ')}`);
    break;
  }
  case 'doc': {
    if (rest[0] !== 'send') { console.log(HELP); break; }
    const [src, dst] = rest.slice(1); const [fromRef, name] = src.split(':');
    const from = await task(fromRef), to = await task(dst);
    const r = await call('POST', '/api/docs/send', { from: from.id, name, to: to.id }); console.log(`Copied to ${r.path}`);
    break;
  }
  case 'inbox': {
    if (rest[0] !== 'wait') { console.log(HELP); break; }
    const id = process.env.TASK_ID; if (!id) { console.error('tb inbox wait: TASK_ID is not set (run it inside a Taskboard task)'); process.exit(1); }
    const timeout = Number(flag('--timeout', '3600')) * 1000, start = Date.now();
    const sender = f => !f ? 'unknown sender' : f.task === 'you' ? 'the user' : f.task === '__review' ? 'the user Inbox (the user\'s comments)' : f.num ? `task #${f.num} "${f.title}"` : `task ${f.task}`;
    for (;;) {
      const { files } = await call('POST', `/api/tasks/${id}/inbox/take`);
      if (files.length) { console.log(files.map(f => `${f.path}  (from ${sender(f.from)})`).join('\n')); break; }
      if (Date.now() - start >= timeout) { console.log('tb inbox wait: timed out, no new files'); process.exit(2); }
      await sleep(Math.min(2000, Math.max(0, timeout - (Date.now() - start))));
    }
    break;
  }
  case 'review': {
    const path = resolve(rest[0] || ''); await call('POST', '/api/review/request', { path, task: process.env.TASK_ID });
    console.log('Marked for review. The user sees it on the user Inbox; their comments will arrive in your inbox.');
    break;
  }
  case 'release-request': {
    if (!process.env.TASK_ID) { console.error('tb release-request: run this inside a Taskboard task'); process.exit(1); }
    await call('POST', '/api/release/request', {});
    break;
  }
  case 'permit': {
    const action = rest[0];
    if (action === 'request') {
      if (!process.env.TASK_ID || process.env.TASK_ID === 'controller') { console.error('tb permit request: run this inside a task'); process.exit(1); }
      const reason = flag('--reason');
      const command = flag('--command');
      const cwd = flag('--cwd');
      const timeout = flag('--timeout');
      const stepsFile = flag('--steps');
      const network = has('--network');
      if (!reason || (!!command === !!stepsFile)) { console.error('tb permit request: give --reason and exactly one of --command or --steps'); process.exit(1); }
      if (stepsFile && (cwd || timeout || network)) { console.error('tb permit request: set the directory, timeout, and network flag in each step'); process.exit(1); }
      const steps = stepsFile ? JSON.parse(readFileSync(resolve(stepsFile), 'utf8')).steps : [{ command, ...(cwd ? { cwd: resolve(cwd) } : {}), ...(timeout ? { timeoutSeconds: Number(timeout) } : {}), network }];
      const result = await call('POST', '/api/permits', { reason, steps });
      if (result.push) console.log(`${result.message} Push ${result.push.id}: ${result.push.state}. Read it with tb git push-result ${result.push.id} --wait.`);
      else if (result.permit) console.log(`Permit ${result.permit.id} waits on the dashboard. Read it with tb permit result ${result.permit.id} --wait.`);
      else console.log('This needs a release request: run tb release-request. The release card was decided.');
    } else if (action === 'result') {
      const id = rest[1]; if (!id) { console.error('tb permit result: give an ID'); process.exit(1); }
      const wait = has('--wait');
      for (;;) {
        const p = await call('GET', `/api/permits/${encodeURIComponent(id)}`);
        if (!wait || !['pending', 'running'].includes(p.state)) {
          console.log(JSON.stringify(p, null, 2));
          if (wait && p.state !== 'succeeded') process.exitCode = 3;
          break;
        }
        await sleep(2000);
      }
    } else if (action === 'list') console.log(JSON.stringify(await call('GET', '/api/permits'), null, 2));
    else if (action === 'approve') {
      if (process.env.TASK_ID !== 'controller') { console.error('tb permit approve: controller only'); process.exit(1); }
      const userRequest = flag('--user-request');
      if (!rest[1] || !userRequest) { console.error('tb permit approve ID --user-request "text"'); process.exit(1); }
      console.log(JSON.stringify(await call('POST', `/api/permits/${encodeURIComponent(rest[1])}/controller-approve`, { userRequest }), null, 2));
    } else { console.error('tb permit request | result | list | approve'); process.exit(1); }
    break;
  }
  case 'git': {
    if (!process.env.TASK_ID) { console.error('tb git: run this inside a Taskboard task'); process.exit(1); }
    if (rest[0] === 'merge-request') await call('POST', '/api/git/merge-request', {});
    else if (rest[0] === 'commit') console.log((await call('POST', '/api/git/commit', { message: rest.slice(1).join(' ') })).result);
    else if (rest[0] === 'rebase') console.log((await call('POST', '/api/git/rebase', {})).result);
    else if (rest[0] === 'push-request') {
      if (rest.some(x => /^(--force|--delete|--tags|--mirror|--all)(?:$|[=-])/.test(x))) { console.error('tb git push-request: force pushes, deletions, and tags are not allowed'); process.exit(1); }
      const reason = flag('--reason', ''); const branch = flag('--branch', undefined); const remote = flag('--remote', 'origin'); const thenRelease = has('--then-release');
      if (!reason) { console.error('tb git push-request: give --reason'); process.exit(1); }
      const result = await call('POST', '/api/git/push-request', { reason, branch, remote, thenRelease });
      console.log(`Push ${result.push.id}: ${result.push.state}. Read it with tb git push-result ${result.push.id} --wait.`);
    } else if (rest[0] === 'push-result') {
      const id = rest[1]; if (!id) { console.error('tb git push-result: give an ID'); process.exit(1); }
      const wait = has('--wait');
      for (;;) {
        const result = await call('GET', `/api/git/pushes/${encodeURIComponent(id)}`);
        if (result.state !== 'pending' || !wait) { console.log(JSON.stringify(result, null, 2)); break; }
        await new Promise(resolve => setTimeout(resolve, 2000));
      }
    } else { console.error('tb git commit | rebase | merge-request | push-request | push-result'); process.exit(1); }
    break;
  }
  case 'park': { const t = await task(rest[0]); await call('POST', `/api/tasks/${t.id}/status`, { status: 'parked' }); console.log(`#${t.num} set aside.`); break; }
  // archive = done: ends the agent's session too (otherwise its next turn would bring the task back)
  case 'archive': { const t = await task(rest[0]); await call('POST', `/api/tasks/${t.id}/kill`, {}); console.log(`#${t.num} ended and archived.`); break; }
  default: console.log(HELP);
}
