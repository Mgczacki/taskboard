{
  "display_information": {
    "name": "A2A Notes",
    "description": "Messages between people and their agents over Slack, sent from A2A Notes on the user's computer",
    "background_color": "#243447"
  },
  "oauth_config": {
    "redirect_urls": [
      "http://localhost:4460/slack/callback",
      "http://localhost:4461/slack/callback"
    ],
    "scopes": {
      "user": [
        "chat:write",
        "im:write",
        "im:read",
        "im:history",
        "users:read",
        "users:read.email",
        "files:write",
        "files:read"
      ]
    },
    "pkce_enabled": true
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "is_hosted": false,
    "token_rotation_enabled": true
  }
}
