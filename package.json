{
  "name": "taskboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local board for Claude Code and Codex agents running in tmux.",
  "scripts": {
    "dev": "node scripts/sandbox.mjs dev",
    "build": "pnpm check:ui-controls && vite build",
    "check:ui-controls": "node scripts/check-ui-controls.mjs",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "stop": "node scripts/stop.mjs",
    "sandbox": "node scripts/sandbox.mjs",
    "release": "node scripts/release.mjs",
    "rollback": "node scripts/rollback.mjs",
    "app": "pnpm --dir desktop setup"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-webgl": "0.19.0",
    "dompurify": "^3.4.16",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.14",
    "mermaid": "^12.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "node-pty"
    ]
  }
}
